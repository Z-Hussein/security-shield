{
    "name": "security-shield",
    "version": "2.1.5",
    "description": "Security checks for anything entering the system from outside - internet content, downloads, and new resources. External information is never trusted until evidence confirms it cannot harm the system.",
    "author": "Z-Hussein",
    "license": "MIT-0",
    "keywords": [
        "security",
        "safety",
        "external-content",
        "download-verification",
        "credential-protection",
        "prompt-injection",
        "defensive",
        "write-scope-restriction",
        "threat-handling",
        "context-compromise-recovery"
    ],
    "compatibility": {
        "openclaw": ">=2026.3.0",
        "platform": [
            "windows",
            "linux",
            "macos"
        ]
    },
    "features": {
        "external-content-verification": true,
        "download-integrity-check": true,
        "evidence-before-trust": true,
        "sandbox-isolation": true,
        "supply-chain-security": true,
        "prompt-injection-defense": true,
        "credential-protection": true,
        "detailed-logging": true,
        "full-system-audit": true
    },
    "security": {
        "pattern-strings": false,
        "abstract-descriptions": true
    },
    "installation": {
        "method": "clawhub",
        "command": "openclaw skills install @z-hussein/security-shield",
        "cross-agent-command": "npx skills add https://clawhub.ai/z-hussein/skills/security-shield",
        "page": "https://clawhub.ai/z-hussein/skills/security-shield"
    }
}
